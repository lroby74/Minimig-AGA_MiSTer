From dfda25900a44cb6b395e21dc81c9a6bdc6c831cc Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 18 Sep 2026 17:15:52 +0000
Subject: [PATCH] Minimig: let the CPU menu reach the 68030

The Minimig core carries a 68030 mode - the 68020 core plus the 68030
supervisor register set, at a selectable 25, 40 or 50MHz - and it is picked by
CPU type code 10 in the config byte, with the clock in bits 7-6. The firmware
could not ask for it, three times over: the menu showed that slot as "-----",
loading a config corrected code 10 back to 68020, and minimig_ConfigCPU masked
the byte to six bits so the clock bits never left the board.

The CPU line now cycles through eight settings instead of four - 68000, 68010,
68020 Fast, 68020 ~14MHz, then the 68030 at 25, 40 and 50MHz and unthrottled -
with the clock shown after the name. Nothing else in the menu moves, so no
other item is renumbered and nothing else in HandleUI changes. D-Cache and the
larger FastRAM sizes already keyed off bit 1 of the type, which code 10 has, so
both work for the 68030 without being touched.

Dropping the load-time correction means a config selecting the 68030 now
selects it. Loading one under a core that does not offer the mode gives an
undefined CPU, the same as asking any core for something it lacks.

The chipset help text mentions the 68030 and says it has no MMU and no FPU.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Acc82W78u6gHd2k9KDssJb
---
 menu.cpp                           | 13 +++++++++----
 support/minimig/minimig_config.cpp |  8 ++++----
 support/minimig/minimig_config.h   |  1 +
 3 files changed, 14 insertions(+), 8 deletions(-)

diff --git a/menu.cpp b/menu.cpp
index 9577174..0bbcdbc 100644
--- a/menu.cpp
+++ b/menu.cpp
@@ -301,7 +301,7 @@ static const char *helptexts[] =
 	helptext_custom,
 	"                                Welcome to MiSTer! Use the cursor keys to navigate the menus. Use space bar or enter to select an item. Press Esc or F12 to exit the menus. Joystick emulation on the numeric keypad can be toggled with the numlock or scrlock key, while pressing Ctrl-Alt-0 (numeric keypad) toggles autofire mode.",
 	"                                Minimig can emulate an A600/A1200 IDE harddisk interface. The emulation can make use of Minimig-style hardfiles (complete disk images) or UAE-style hardfiles (filesystem images with no partition table).",
-	"                                Minimig's processor core can emulate a 68000 (cycle accuracy as A500/A600) or 68020 (maximum performance) processor with transparent cache.",
+	"                                Minimig's processor core can emulate a 68000 (cycle accuracy as A500/A600), a 68020 (at A1200 speed or as fast as it will go) or a 68030 at 25, 40 or 50MHz, all with transparent cache. The 68030 has no MMU and no FPU, and needs a core that offers it.",
 	"                                Minimig can make use of up to 2 megabytes of Chip RAM, up to 1.5 megabytes of Slow RAM (A500 Trapdoor RAM), and up to 384 megabytes of Fast RAM (8MB max for 68000 mode). To use the HRTmon feature you will need a file on the SD card named hrtmon.rom.",
 	"                                Backspace key (or B-hold + A on gamepad) to unmount",
 	"                                Backspace key (or B-hold + A on gamepad) to clear stored option. You have to reload the core to be able to use default value.",
@@ -6547,6 +6547,7 @@ void HandleUI(void)
 		strcat(s, config_cpu_msg[minimig_config.cpu & 0x03]);
 		if ((minimig_config.cpu & 0x23) == 0x23) strcat(s, " ~14MHz");
 		if ((minimig_config.cpu & 0x23) == 0x03) strcat(s, " Fast");
+		if ((minimig_config.cpu & 0x03) == 0x02) strcat(s, config_cpu030_msg[(minimig_config.cpu >> 6) & 3]);
 		OsdWrite(m++, s, menusub == 0, 0);
 		strcpy(s, " D-Cache  : ");
 		strcat(s, (minimig_config.cpu & 16) ? "On" : "Off");
@@ -6616,15 +6617,19 @@ void HandleUI(void)
 		{
 			if (menusub == 0)
 			{
-				static const unsigned char cpu_steps[4] = { 0, 1, 3, 0x23 };
+				// 68000, 68010, 68020 fast, 68020 at A1200 speed, then the
+				// 68030 at each of its four clock settings. Bits 7-6 are the
+				// 68030 clock, 5 the 68020 stock speed throttle, 1-0 the type.
+				static const unsigned char cpu_steps[8] = { 0, 1, 3, 0x23, 0x02, 0x42, 0x82, 0xc2 };
 				int step = ((minimig_config.cpu & 3) == 0) ? 0 :
 				           ((minimig_config.cpu & 3) == 1) ? 1 :
+				           ((minimig_config.cpu & 3) == 2) ? 4 + ((minimig_config.cpu >> 6) & 3) :
 				           (minimig_config.cpu & 0x20) ? 3 : 2;
 
-				step = (step + (minus ? 3 : 1)) & 3;
+				step = (step + (minus ? 7 : 1)) & 7;
 
 				menustate = MENU_MINIMIG_CHIPSET1;
-				minimig_config.cpu = (minimig_config.cpu & 0xdc) | cpu_steps[step];
+				minimig_config.cpu = (minimig_config.cpu & 0x1c) | cpu_steps[step];
 				minimig_ConfigCPU(minimig_config.cpu);
 			}
 			else if (menusub == 1 && (minimig_config.cpu & 0x2))
diff --git a/support/minimig/minimig_config.cpp b/support/minimig/minimig_config.cpp
index 7026a30..a7559b8 100644
--- a/support/minimig/minimig_config.cpp
+++ b/support/minimig/minimig_config.cpp
@@ -26,7 +26,8 @@ const char *config_memory_chip_msg[] = { "512K", "1M",   "1.5M", "2M" };
 const char *config_memory_slow_msg[] = { "none", "512K", "1M",   "1.5M" };
 const char *config_memory_fast_msg[][8] = { { "none", "2M", "4M", "8M", "8M",    "8M",    "8M",   "8M" } ,
 											{ "none", "2M", "4M", "8M", "256M", "384M", "256M", "256M" } };
-const char *config_cpu_msg[] = { "68000", "68010", "-----","68020" };
+const char *config_cpu_msg[] = { "68000", "68010", "68030", "68020" };
+const char *config_cpu030_msg[] = { " 25MHz", " 40MHz", " 50MHz", " Fast" };
 const char *config_chipset_msg[] = { "OCS-A500", "OCS-A1000", "ECS", "---", "---", "---", "AGA", "---" };
 
 typedef struct
@@ -610,8 +611,6 @@ int minimig_cfg_load(int num)
 		BootPrintEx(">>> No config found. Using defaults. <<<");
 	}
 
-	if ((minimig_config.cpu & 0x03) == 0x02) minimig_config.cpu |= 0x01;
-
 	a2065_cfg_set(minimig_config.a2065_mode);
 
 	for (int i = 0; i < 4; i++)
@@ -855,7 +854,8 @@ void minimig_ConfigMemory(unsigned char memory)
 
 void minimig_ConfigCPU(unsigned char cpu)
 {
-	spi_uio_cmd8(UIO_MM2_CPU, cpu & 0x3f);
+	// 7-6 68030 clock, 5 68020 stock speed, 4-2 cache, 1-0 CPU type
+	spi_uio_cmd8(UIO_MM2_CPU, cpu);
 }
 
 void minimig_ConfigChipset(mm_configTYPE *config)
diff --git a/support/minimig/minimig_config.h b/support/minimig/minimig_config.h
index e5ad826..7dfa8f2 100644
--- a/support/minimig/minimig_config.h
+++ b/support/minimig/minimig_config.h
@@ -25,6 +25,7 @@ extern const char *config_memory_chip_msg[];
 extern const char *config_memory_slow_msg[];
 extern const char *config_memory_fast_msg[][8];
 extern const char *config_cpu_msg[];
+extern const char *config_cpu030_msg[];
 extern const char *config_chipset_msg[];
 
 typedef struct
-- 
